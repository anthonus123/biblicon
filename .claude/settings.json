{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"; [ -x \"$f\" ] && \"$f\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.sh\"; [ -x \"$f\" ] && \"$f\" || true"
          }
        ]
      }
    ]
  }
}
